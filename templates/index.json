        max-width: 480px;\n    }\n\n    .custom-modal {\n        display: flex;\n        position: fixed;\n        inset: 0;\n        background-color: rgba(0, 0, 0, 0.6);\n        align-items: center;\n        justify-content: center;\n        opacity: 0;\n        visibility: hidden;\n        transform: scale(1);\n        transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;\n        z-index: 1000;\n    }\n\n    .custom-modal.show {\n        opacity: 1;\n        visibility: visible;\n    }\n\n    .custom-modal-overlay {\n        position: absolute;\n        inset: 0;\n        background: transparent;\n        cursor: pointer;\n    }\n\n    .custom-modal-content {\n        position: relative;\n        width: 90%;\n        max-width: 720px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        z-index: 1001;\n        transform: scale(1);\n    }\n\n    .custom-full-video {\n        width: 100%;\n        height: auto;\n        max-height: 85vh;\n        border-radius: 12px;\n        background: black;\n    }\n\n    .custom-close {\n        position: absolute;\n        top: -12px;\n        right: -12px;\n        width: 36px;\n        height: 36px;\n        font-size: 24px;\n        color: white;\n        cursor: pointer;\n        z-index: 1002;\n        background: rgba(0, 0, 0, 0.6);\n        border: none;\n        border-radius: 50%;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        transition: background 0.3s;\n    }\n\n    .custom-close:hover {\n        background: rgba(255, 255, 255, 0.3);\n    }\n\n    @media (max-width: 768px) {\n        .custom-container {\n            flex-direction: column;\n            text-align: center;\n            gap: 16px;\n        }\n\n        .custom-text-wrapper {\n            max-width: 100%;\n            text-align: center;\n        }\n\n        .custom-video-wrapper {\n            max-width: 100%;\n        }\n\n        .custom-modal-content {\n            width: 95%;\n        }\n\n        .custom-button {\n            width: 100%;\n            max-width: 280px;\n            margin: 0 auto;\n        }\n    }\n<\/style>\n\n<script>\n    function openCustomModal() {\n        let modal = document.getElementById(\"customVideoModal\");\n        let video = document.getElementById(\"customFullVideo\");\n\n        modal.style.visibility = \"visible\"; \n        modal.classList.add(\"show\");\n\n        video.currentTime = 0; \n        video.play();\n    }\n\n    function closeCustomModal() {\n        let modal = document.getElementById(\"customVideoModal\");\n        let video = document.getElementById(\"customFullVideo\");\n\n        modal.classList.remove(\"show\");\n\n        setTimeout(() => {\n            modal.style.visibility = \"hidden\"; \n        }, 300);\n        \n        video.pause();\n        video.currentTime = 0;\n    }\n\n    document.getElementById(\"customVideoModal\").addEventListener(\"click\", function(event) {\n        let modalContent = document.querySelector(\".custom-modal-content\");\n        if (!modalContent.contains(event.target)) {\n            closeCustomModal();\n        }\n    });\n<\/script>","full_width":false,"show_divider":false,"padding_top":56,"padding_bottom":56}},"images_with_text_AN46tC":{"type":"images-with-text","blocks":{"subheading_Wd6C7A":{"type":"subheading","settings":{"subheading":"Enxovais Monte Santo","subheading_size":"h5","secondary_color":true}},"heading_P7zQtD":{"type":"heading","settings":{"heading":"Mais de 40 anos de história","heading_size":"h1","heading_tag":"h2"}},"text_JTd7dj":{"type":"text","settings":{"text":"<p>Com oito filiais e 48 anos de tradição, a Enxovais Monte Santo é referência em Cama, Mesa e Banho, entregando conforto, qualidade e um atendimento sempre personalizado.<\/p>","text_size":"typeset","secondary_color":false}},"button_h3mR9e":{"type":"button","settings":{"button_label":"Saiba Mais","button_link":"","button_size"